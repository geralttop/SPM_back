# JWT Secrets - Сгенерируйте сильные секреты для продакшена
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-min-32-chars

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# Email configuration
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USER=your-email@yandex.ru
MAIL_PASS=your-yandex-app-password
MAIL_FROM_NAME=SPM

# Application
NODE_ENV=development
PORT=3000

# Admin user (for create-admin script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password
ADMIN_USERNAME=admin